### セットアップ: 家計簿レコード1登録
POST {{host}}/api/v1/records
Content-Type: application/json
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/
X-XSRF-TOKEN: {{xsrfToken}}

{
  "purchaseDate": "2026-07-27",
  "amountTypeId": 1,
  "amount": 1000,
  "details": "テスト用レコード1",
  "kakeiboDefaultCategoryId": 1
}

> {%
  client.test("セットアップ: レコード1登録 → 201", function () {
    client.assert(response.status === 201);
  });
  client.global.set("recordId", response.body.data.id);
%}

