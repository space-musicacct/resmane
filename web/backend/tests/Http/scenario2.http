### ── セットアップ ──────────────────────────────────────

### CSRF Cookie 取得
GET {{host}}/sanctum/csrf-cookie
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/

> {%
  client.global.set("xsrfToken", decodeURIComponent(
    response.headers.valuesOf("Set-Cookie")
      .filter(c => c.startsWith("XSRF-TOKEN="))
      .map(c => c.split("=")[1].split(";")[0])[0]
  ));
%}

###

### セットアップ: ユーザー登録
POST {{host}}/api/v1/register
Content-Type: application/json
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/
X-XSRF-TOKEN: {{xsrfToken}}

{
  "loginId": "hanako_tanaka",
  "email": "hanako@example.com",
  "name": "田中花子",
  "password": "password123",
  "passwordConfirmation": "password123"
}

> {%
  client.test("セットアップ: ユーザー登録 → 201", function () {
    client.assert(response.status === 201);
  });
%}

