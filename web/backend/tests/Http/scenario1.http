### 10. 自己レビュー一覧 (FSRI-001)
GET {{host}}/api/v1/records/{{recordId}}/reviews
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/

> {%
  client.test("自己レビュー一覧 → 200", function () {
    client.assert(response.status === 200);
    client.assert(response.body.data.length >= 1);
    response.body.data.forEach(function (review) {
      client.assert(review.evaluation !== undefined);
    });
  });
%}

