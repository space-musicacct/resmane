> {%
  client.test("家計簿一覧 → 200", function () {
    client.assert(response.status === 200);
    client.assert(response.body.data.length >= 1);
    client.assert(response.body.meta !== undefined);
    client.assert(response.body.summary !== undefined);
  });
%}

