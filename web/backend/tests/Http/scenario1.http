### 11. AIフィードバック要求 (FPS-002)
POST {{host}}/api/v1/records/{{recordId}}/posts
Content-Type: application/json
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/
X-XSRF-TOKEN: {{xsrfToken}}

{}

> {%
  client.test("AIフィードバック要求 → 201", function () {
    client.assert(response.status === 201);
    client.assert(response.body.data.userPost === null);
    client.assert(response.body.data.aiPost.aiStatus.statusName === "pending");
  });
%}

