###

### 5. 家計簿登録 (FKS-001)
POST {{host}}/api/v1/records
Content-Type: application/json
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/
X-XSRF-TOKEN: {{xsrfToken}}

{
  "purchaseDate": "2026-07-27",
  "amountTypeId": 1,
  "amount": 1500,
  "details": "コンビニでお昼ご飯",
  "kakeiboDefaultCategoryId": 1
}

> {%
  client.test("家計簿登録 → 201", function () {
    client.assert(response.status === 201);
    client.assert(response.body.data.amount === 1500);
    client.assert(response.body.data.amountTypeName !== undefined);
    client.assert(response.body.data.categoryName !== undefined);
  });
  client.global.set("recordId", response.body.data.id);
%}

