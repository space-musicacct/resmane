### ── セットアップ ──────────────────────────────────────

### CSRF Cookie 取得
GET {{host}}/sanctum/csrf-cookie
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/

> {%
  client.log("CSRF status: " + response.status);
  const cookies = response.headers.valuesOf("Set-Cookie");
  client.log("Set-Cookie count: " + (cookies ? cookies.length : "null"));
  if (cookies) {
    const xsrf = cookies.filter(c => c.startsWith("XSRF-TOKEN="));
    client.log("XSRF cookies: " + xsrf.length);
    if (xsrf.length > 0) {
      const token = decodeURIComponent(xsrf[0].split("=")[1].split(";")[0]);
      client.global.set("xsrfToken", token);
      client.log("Token set OK");
    } else {
      client.log("ERROR: No XSRF-TOKEN cookie found");
    }
  } else {
    client.log("ERROR: No Set-Cookie headers");
  }
%}

###

### セットアップ: ユーザー登録
POST {{host}}/api/v1/register
Content-Type: application/json
Accept: application/json
X-Requested-With: XMLHttpRequest
Referer: {{host}}/
X-XSRF-TOKEN: {{xsrfToken}}

{
  "loginId": "hanako_tanaka",
  "email": "hanako@example.com",
  "name": "田中花子",
  "password": "password123",
  "passwordConfirmation": "password123"
}

> {%
  client.test("セットアップ: ユーザー登録 → 201", function () {
    client.assert(response.status === 201);
  });
%}

