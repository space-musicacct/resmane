# =================================================================
# レスマネ ローカル開発環境 環境変数
# =================================================================
# 使い方:
#   1. このファイルをコピー: cp .env.example .env
#   2. 必要に応じて値を変更
#   3. docker compose up -d --build で起動
# =================================================================

# --- ポートマッピング (ホスト側ポート) ---
NGINX_PORT=40080
DB_EXTERNAL_PORT=43306

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=resmane
MYSQL_USER=resmane_user
MYSQL_PASSWORD=resmane_password

# --- Vite ---
VITE_API_BASE_URL=/api

# --- Python Worker (レスマネ本体 DB) ---
WORKER_DB_HOST=db
WORKER_DB_PORT=3306
WORKER_DB_NAME=resmane
WORKER_DB_USER=resmane_user
WORKER_DB_PASSWORD=resmane_password

# --- Python Worker (Worker 専用 DB) ---
WORKER_OWN_DB_HOST=db
WORKER_OWN_DB_PORT=3306
WORKER_OWN_DB_NAME=resmane_worker
WORKER_OWN_DB_USER=resmane_worker
WORKER_OWN_DB_PASSWORD=resmane_password

# --- Python Worker (動作設定) ---
WORKER_POLL_INTERVAL_SEC=30
WORKER_STALE_TIMEOUT_SEC=300

# --- AI API ---
AI_API_KEY=your-api-key-here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.5-flash
